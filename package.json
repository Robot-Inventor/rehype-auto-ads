{
  "name": "rehype-auto-ads",
  "version": "2.0.12",
  "description": "rehype.js plugin that automatically inserts Google Adsense (and theoretically any ad service) code",
  "keywords": [
    "markdown",
    "rehype-plugin"
  ],
  "homepage": "https://github.com/Robot-Inventor/rehype-auto-ads#readme",
  "bugs": {
    "url": "https://github.com/Robot-Inventor/rehype-auto-ads/issues"
  },
  "license": "MIT",
  "author": "Robot-Inventor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robot-Inventor/rehype-auto-ads.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "version": "npm run build && git add .",
    "test": "vitest",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint ./src",
    "ci:version": "changeset version && npm run version",
    "ci:publish": "npm run build && changeset publish"
  },
  "dependencies": {
    "@types/hast": "^3.0.0",
    "hast-util-from-html": "^2.0.0",
    "hast-util-is-element": "^3.0.0",
    "unified": "^11.0.0",
    "unist-util-visit-parents": "^6.0.0",
    "vfile": "^6.0.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@robot-inventor/oxlint-config": "^1.0.0",
    "@robot-inventor/tsconfig-base": "^7.0.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.83.0",
    "rehype-stringify": "^10.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
